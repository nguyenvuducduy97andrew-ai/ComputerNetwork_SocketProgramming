# Python bytecode, test and tooling caches
__pycache__/
*.py[cod]
.pytest_cache/
.mypy_cache/
.ruff_cache/
.coverage
.coverage.*
htmlcov/

# Local Python environments and build output
.venv/
venv/
build/
dist/
*.egg-info/

# Local secrets/configuration (keep a shareable template if one is added)
.env
.env.*
!.env.example

# IDE and operating-system metadata
.vs/
.vscode/
.idea/
.DS_Store
Thumbs.db
Desktop.ini

# Runtime logs and incomplete temporary files
logs/
*.tmp
*.part

# Files generated by live transfers. Keep the committed demo fixtures.
data/client_downloads/*
!data/client_downloads/999.txt
!data/client_downloads/abcabc.txt
data/server_storage/*
!data/server_storage/abc.txt
